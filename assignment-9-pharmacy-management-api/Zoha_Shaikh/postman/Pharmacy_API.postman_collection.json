            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 400 if already exists', function () { pm.expect([201, 400]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
