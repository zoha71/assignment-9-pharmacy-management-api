            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"alice_new@pharmacy.com\",\n  \"password\": \"Customer@123\",\n  \"phone\": \"+1-555-0999\",\n  \"address\": \"12 Elm Street\"\n}"
